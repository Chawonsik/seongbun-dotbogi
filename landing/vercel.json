{
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/concept",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/concept", "destination": "/concept.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/notes/:slug", "destination": "/notes/:slug.html" }
  ]
}
